# Copia in .env.local e compila con i valori del progetto Supabase.
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<publishable-or-anon-key>"

# Dispositivi (Garmin, Polar, Suunto, Strava, ...): nessuna variabile d'ambiente.
# Il collegamento passa da Intervals.icu con la API key personale dell'atleta,
# salvata per-atleta nel DB (tabella intervals_connections).

# URL pubblico dell'app (usato nei link delle notifiche). Senza slash finale.
NEXT_PUBLIC_APP_URL="https://irene-coletto-tabella.vercel.app"

# Notifica EMAIL alla pubblicazione tabella — Resend (https://resend.com).
# Se mancano, l'email viene semplicemente saltata (la pubblicazione funziona).
# Il dominio in NOTIFY_EMAIL_FROM va verificato su Resend (record DNS su Vercel).
RESEND_API_KEY="<resend-api-key>"
NOTIFY_EMAIL_FROM="Irene Coletto <irene@irenecolettocoaching.com>"
# (Opzionale) "rispondi a": le email partono dal dominio verificato ma le
# risposte degli atleti arrivano sulla casella reale della coach.
NOTIFY_REPLY_TO="irene@trisutto.com"

# Notifica SMS alla pubblicazione tabella — Twilio (https://twilio.com).
# Se mancano, l'SMS viene semplicemente saltato. Il numero dell'atleta va
# inserito nella scheda atleta in formato E.164 (es. +39333...).
TWILIO_ACCOUNT_SID="<twilio-account-sid>"
TWILIO_AUTH_TOKEN="<twilio-auth-token>"
TWILIO_FROM_NUMBER="+39..."
